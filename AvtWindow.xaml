<Window x:Class="Apteka.AvtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apteka"
        mc:Ignorable="d"
        Title="AvtWindow" Height="400" Width="600" Background="#FF0B5B4F" WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" BorderBrush="White" BorderThickness="10">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF5FCAC4"/>
            <Setter Property="Foreground" Value="#FFD1FFF4"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCFFFF4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="Margin" Value="100,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#FF0B5B4F"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="BorderBrush" Value="#FFB2FFFD"/>
            <Setter Property="Margin" Value="100,5,100,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#FF0B5B4F"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="BorderBrush" Value="#FFB2FFFD"/>
            <Setter Property="Margin" Value="100,5,100,5"/>
        </Style>
    </Window.Resources>
    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Image Source="/Images/logo_apteka.png" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,-80,0" />
            <StackPanel Orientation="Vertical" Margin="0,10,10,10" Width="376">
                <TextBlock Text="Пилюля" VerticalAlignment="Center" FontSize="60"/>
                <TextBlock Text="Аптека" VerticalAlignment="Center" FontSize="36" HorizontalAlignment="Center" Foreground="#FF99C3B9"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Логин:"/>
        <TextBox x:Name="LogTB" Foreground="#FFD1FFF4" MaxLength="20" />
        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="PassTB" Foreground="#FFD1FFF4" MaxLength="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" Click="Button_Click" />
            <Button x:Name="RegBtn"  Content="Выйти" Click="RegBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
