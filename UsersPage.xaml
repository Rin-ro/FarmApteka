<Page x:Class="Apteka.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Apteka"
      mc:Ignorable="d" 
      d:DesignHeight="335" d:DesignWidth="780"
      Title="UsersPage">
    <Grid>
        <DataGrid x:Name="usersDataTable" Background="#FFCBFFFA" AutoGenerateColumns="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#FF289288"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF15615A"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id Клиента" Binding="{Binding customer_id}" FontSize="14" FontFamily="Arial" Width="*" />
                <DataGridTextColumn Header="Имя" Binding="{Binding first_name}" FontSize="14" FontFamily="Arial" Width="2*"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding last_name}" FontSize="14" FontFamily="Arial" Width="2*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" FontSize="14" FontFamily="Arial" Width="2*"/>
                <!--<DataGridTextColumn  Header="Id Клиента" Binding="{Binding Id}" FontSize="18" FontFamily="Arial" Width="*" ></DataGridTextColumn>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" FontSize="18" FontFamily="Arial" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Пароль" Binding="{Binding PasswordHash}" FontSize="18" FontFamily="Arial" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Email или телефон" Binding="{Binding EmailOrPhone}" FontSize="18" FontFamily="Arial" Width="*"></DataGridTextColumn>-->
                <!--<DataGridTextColumn  Header="ФИО" Binding="{Binding FIO}" FontSize="18" FontFamily="Arial" Width="*" ></DataGridTextColumn>
                <DataGridTextColumn  Header="Дата создания" Binding="{Binding DateOfCreate}" FontSize="18" FontFamily="Arial" Width="*" ></DataGridTextColumn>-->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
