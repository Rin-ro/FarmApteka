<Window x:Class="Apteka.OrderStatusEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="200" Width="350" Background="#FF0B5B4F" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen" BorderBrush="White" BorderThickness="10"
        Title="Изменить статус заказа">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FF0B5B4F"/>
            <Setter Property="Foreground" Value="#FFD1FFF4"/>
            <Setter Property="BorderBrush" Value="#FFB2FFFD"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF5FCAC4"/>
            <Setter Property="Foreground" Value="#FFD1FFF4"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
        <TextBlock Text="Статус заказа:" Foreground="#FFCFFFF4" Margin="0,0,0,5"/>
        <ComboBox x:Name="StatusCombo" SelectedIndex="0" Foreground="#FF088668">
            <ComboBoxItem>Новый</ComboBoxItem>
            <ComboBoxItem>В обработке</ComboBoxItem>
            <ComboBoxItem>Доставлен</ComboBoxItem>
            <ComboBoxItem>Отменен</ComboBoxItem>
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Сохранить" Click="Button_Click" Margin="5"/>
            <Button Content="Отмена" Click="Cancel_Click" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>