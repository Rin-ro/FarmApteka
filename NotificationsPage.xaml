<Page x:Class="Apteka.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Apteka"
      mc:Ignorable="d" 
      d:DesignHeight="335" d:DesignWidth="780"
      Title="NotificationsPage">
    <Grid>
        <DataGrid x:Name="notificationsDataTable" Background="#FFCBFFFA">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="#FF289288"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF15615A"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn  Header="ID" Binding="{Binding Id}" FontSize="18" FontFamily="Arial" Width="*" ></DataGridTextColumn>
                <DataGridTextColumn Header="ID пользователя" Binding="{Binding UserId}" FontSize="18" FontFamily="Arial" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" FontSize="18" FontFamily="Arial" Width="2*"></DataGridTextColumn>
                <DataGridTextColumn  Header="Дата создания" Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="18" FontFamily="Arial" Width="*" ></DataGridTextColumn>
                <DataGridTextColumn  Header="Прочитано" Binding="{Binding IsRead}" FontSize="18" FontFamily="Arial" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
