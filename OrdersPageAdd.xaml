<Window  x:Class="Apteka.OrdersPageAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Apteka"
      mc:Ignorable="d" 
      Height="400" Width="600" Background="#FF0B5B4F" WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" BorderBrush="White" BorderThickness="10"
      Title="OrdersPage">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF5FCAC4"/>
            <Setter Property="Foreground" Value="#FFD1FFF4"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCFFFF4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FF0B5B4F"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="BorderBrush" Value="#FFB2FFFD"/>
            <Setter Property="Margin" Value="20,2,20,8"/>
        </Style>
    </Window.Resources>
    <ScrollViewer>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,10,0">
                <Image Source="/Images/logo_apteka.png" Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,-100,0" />
                <StackPanel Orientation="Vertical" Margin="-5,5,-30,10" Width="376">
                    <TextBlock Text="Заказ" FontSize="40" HorizontalAlignment="Center" Height="90" VerticalAlignment="Center" Padding="0,25,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="ID пользователя:" Margin="20,-10,0,0"/>
            <TextBox x:Name="UserTB" Foreground="#FFD1FFF4" MaxLength="10" />

            <TextBlock Text="Статус:"/>
            <TextBox x:Name="StatusTB" Foreground="#FFD1FFF4" MaxLength="50" />

            <TextBlock Text="Способ оплаты:"/>
            <TextBox x:Name="PaymentTB" Foreground="#FFD1FFF4" MaxLength="50" />

            <TextBlock Text="Способ доставки:"/>
            <TextBox x:Name="DeliveryTB" Foreground="#FFD1FFF4" MaxLength="50" />

            <TextBlock Text="Дата доставки:"/>
            <TextBox x:Name="DeliveryDateTB" Foreground="#FFD1FFF4" MaxLength="10" />

            <TextBlock Text="Время доставки:"/>
            <TextBox x:Name="DeliveryTimeTB" Foreground="#FFD1FFF4" MaxLength="8" />

            <TextBlock Text="Итоговая сумма:"/>
            <TextBox x:Name="TotalTB" Foreground="#FFD1FFF4" MaxLength="10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Добавить" Click="Button_Click" />
                <Button x:Name="RegBtn"  Content="Выйти" Click="RegBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
