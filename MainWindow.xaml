<Window x:Class="Apteka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apteka"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FFEAFFFD"  >
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#00DDDDDD"/>
            <Setter Property="Foreground" Value="#FF13564E"/>
            <Setter Property="BorderBrush" Value="#FF13564E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Sitka Text"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="60"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" >
            <Button Width="60" Margin="15,10,10,10" >
                <Image Source="/Images/logo_apteka_t.png" ></Image>
            </Button>
            <Button x:Name="UsersBut" Content="Клиенты" Click="UsersBut_Click"/>
            <Button x:Name="MedicinesBut" Content="Лекарства" Click="MedicinesBut_Click"/>
            <Button x:Name="CategoriesBut" Content="Категории" Click="CategoriesBut_Click"/>
            <Button x:Name="OrdersBut" Content="Заказы" Click="OrdersBut_Click"/>
            <Button x:Name="OrdersPositionsBut" Content="Позиции&#10;Заказов" Click="OrdersPositionsBut_Click"/>
        </StackPanel>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated" Margin="10" Foreground="#FF13564E" BorderBrush="#FF13564E" BorderThickness="2" Height="335"></Frame>
    </DockPanel>
</Window>
